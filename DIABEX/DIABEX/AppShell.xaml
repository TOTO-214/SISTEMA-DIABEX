<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DIABEX.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DIABEX.Views"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="Transparent"
    Shell.ForegroundColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}"
    Shell.TitleColor="Transparent">

    <!-- Quita los títulos de la barra superior sin ocultar la hamburguesa -->
    <Shell.TitleView>
        <Grid HeightRequest="0" />
    </Shell.TitleView>

    <FlyoutItem Title="Inicio">
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Mi Cuenta">
        <ShellContent ContentTemplate="{DataTemplate views:MiCuentaPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Sobre Nosotros">
        <ShellContent ContentTemplate="{DataTemplate views:SobreNosotrosPage}" />
    </FlyoutItem>

</Shell>