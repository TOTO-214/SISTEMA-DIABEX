<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DIABEX.Views.CompraEquipoPage"
             Title="Compra Equipo">

    <ScrollView Padding="15">
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
            <Frame Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Image Source="dotnet_bot.png" HeightRequest="80"/>
                    <Label Text="Glucómetro Digital" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="$25.00" TextColor="#0066CC" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Button Text="Comprar" BackgroundColor="#0066CC" TextColor="White" HeightRequest="35"/>
                </VerticalStackLayout>
            </Frame>

            <Frame Grid.Row="0" Grid.Column="1" CornerRadius="12" Padding="10" HasShadow="True">
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Image Source="dotnet_bot.png" HeightRequest="80"/>
                    <Label Text="Tiras Reactivas (50u)" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="$15.00" TextColor="#0066CC" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Button Text="Comprar" BackgroundColor="#0066CC" TextColor="White" HeightRequest="35"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>