<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DIABEX.Views.RecordatoriosPage"
             Title="Mis Recordatorios"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#121212}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Formulario de Agregar -->
            <Frame CornerRadius="15" Padding="15" HasShadow="True"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⏰ Agregar Nuevo Recordatorio" 
                           FontAttributes="Bold" 
                           FontSize="Medium" 
                           TextColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}"/>

                    <Entry x:Name="TituloEntry" 
                           Placeholder="Ej. Toma de Metformina / Chequeo de Glucosa" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Hora:" VerticalOptions="Center" FontAttributes="Bold"/>
                        <TimePicker x:Name="HoraPicker" Format="hh:mm tt" HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>

                    <Button Text="Guardar Recordatorio" 
                            BackgroundColor="#0066CC" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="10"
                            HeightRequest="45"
                            Clicked="OnGuardarRecordatorioClicked"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Tus Alarmas Programadas" FontAttributes="Bold" FontSize="Large" TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}"/>

            <!-- Lista de Recordatorios -->
            <CollectionView x:Name="RecordatoriosCollectionView" EmptyView="No tienes recordatorios creados.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="12" HasShadow="True" Margin="0,5" Padding="12" 
                               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#2C2C2C}">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Titulo}" FontAttributes="Bold" FontSize="Medium" TextColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Hora}" FontAttributes="Bold" FontSize="Medium" TextColor="#D32F2F"/>
                                <Button Grid.Row="1" Grid.Column="1" Text="Eliminar" BackgroundColor="#D32F2F" TextColor="White" FontSize="Caption" HeightRequest="35" CornerRadius="8"
                                        CommandParameter="{Binding .}" Clicked="OnEliminarClicked"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón Volver al Inicio -->
            <Button Text="Volver al Inicio" 
                    BackgroundColor="Transparent" 
                    TextColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}" 
                    BorderColor="{AppThemeBinding Light=#0066CC, Dark=#4DA6FF}"
                    BorderWidth="1.5"
                    FontAttributes="Bold" 
                    CornerRadius="10"
                    HeightRequest="45"
                    Margin="0,10,0,10"
                    Clicked="OnVolverInicioClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>